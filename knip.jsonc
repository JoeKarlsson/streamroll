{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Run by hand: Runway task manager and the preview generator.
  "entry": ["scripts/*.{ts,mjs}"],
  // scripts/copy-ffmpeg.js copies these packages' files into public/ffmpeg by path, so nothing imports them.
  "ignoreDependencies": ["@ffmpeg/core", "@ffmpeg/ffmpeg"]
}
